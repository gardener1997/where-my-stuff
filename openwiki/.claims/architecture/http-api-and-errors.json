    {
      "id": "claim_58a69a0308ef49f4a07b7cf63fe4ae07",
      "statement": "GET /items composes its filters with AND over direct column equality for category_id, container_id and source_type, plus an EXISTS subquery on item_tags for tag_id; query DTOs have no deny_unknown_fields, so unrecognized query keys are silently ignored instead of rejected.",
