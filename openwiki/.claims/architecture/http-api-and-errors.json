    {
      "id": "claim_7850790c4a6747ec989b93745d59f12e",
      "statement": "Pagination is applied inside the repositories for exactly two endpoints (GET /items and GET /search): page defaults to 1 and is floored at 1, size defaults to 20 and is clamped into 1..=100, and the effective page/size are echoed back in the { items, total, page, size } payload of PaginatedItems and SearchResult.",
      "evidence": [
        {
          "resource": "repo://server/src/models/item.rs#L102-L108",
          "version": "repo-lines-v1:sha256:adef2ff16d8e70ca9537dd13f88df15320f56991eca6a1b53343bf6158f20297:"
        },
        {
          "resource": "repo://server/src/models/search.rs#L15-L21",
