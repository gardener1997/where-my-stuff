    {
      "id": "claim_4537e0a3021143aab99ef5f047a2822d",
      "statement": "The three multipart upload endpoints accept exactly one part named `file`, scanning fields until field.name() == Some(\"file\") and otherwise failing with the 400 message \"no file field found in multipart\"; each upload verifies the parent item or container exists (404) before reading the body.",
      "evidence": [
        {
          "resource": "repo://server/src/handlers/container.rs#L81-L121",
          "version": "repo-lines-v1:sha256:0b3463cac42fa1971f9a98ee8650bf7792a49122a474b438a226cba610b4ed3e:"
