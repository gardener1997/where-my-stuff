    {
      "id": "claim_f29f31ea00e74eeb9f3da6b72d2c101c",
      "statement": "Upload handlers call config::Config::load() per request, which re-reads config.toml, so changes to upload.max_file_size or upload.max_doc_size take effect on the next upload without a restart, even though the /images and /docs static mounts were bound to the startup-time directories.",
