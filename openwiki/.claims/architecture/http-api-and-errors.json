    {
      "id": "claim_a4fa852f3a8441e2b25e6b092cd44737",
      "statement": "Every successful API response is HTTP 200 with a JSON body: single resources and server-side aggregates are returned bare, and delete endpoints return {\"ok\": true}; no handler produces 201 Created or 204 No Content.",
      "evidence": [
        {
          "resource": "repo://server/src/handlers/category.rs#L34-L40",
          "version": "repo-lines-v1:sha256:c57385edd1547b86cf11c8479cca39be4b229e3d72d631b9100d5dede9730dd0:"
        },
        {
