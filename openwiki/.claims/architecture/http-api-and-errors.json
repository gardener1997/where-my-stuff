    {
      "id": "claim_f7788cf4b11148009f47ecb93bcf5bb5",
      "statement": "GET /search requires q and switches strategy on query length: fewer than 3 characters uses a LIKE scan across item name/description/location_note, container name/label, and category name, otherwise an FTS MATCH on the quoted phrase; each hit is { item, highlight } rather than a bare ItemSummary, with highlight built from <mark> snippets joined by \" … \" or falling back to the description truncated at 80 characters.",
      "evidence": [
        {
          "resource": "repo://server/src/models/search.rs#L5-L27",
