    {
      "id": "claim_141d3c5556ca48b6b9ea7dbf8654b074",
      "statement": "GET /containers/{id} returns ContainerDetail with container, path, children, and items, where items comes from item::list with page=1 and size=100, so a container holding more than 100 items silently truncates its detail listing and the inner total is discarded.",
