  "claims": [
    {
      "id": "claim_01cf921f22ae40fb813f03dcc9b2c235",
      "statement": "The entire HTTP API surface is declared in server/src/routes.rs as 28 routes on one Router, which main.rs nests at /api/v1 alongside /images and /docs static mounts and an embedded-SPA fallback, wrapped in a global DefaultBodyLimit of 100MB, permissive CORS, and request tracing.",
      "evidence": [
        {
          "resource": "repo://server/src/main.rs#L45-L53",
          "version": "repo-lines-v1:sha256:08c99ca09c589ba8d485eb7ebde9b440efef5c5dab908b73c3312ae671707f55:"
        },
        {
          "resource": "repo://server/src/routes.rs#L9-L56",
          "version": "repo-lines-v1:sha256:18b18c87a125b36e2ea174647597d10507a8984e8b55bb70c525aabda2b2e173:"
        }
      ]
    },
    {
      "id": "claim_a9b8080c8511446e89518316c1db3449",
      "statement": "Top-level DELETE routes (categories, containers, items, tags) issue unconditional deletes and therefore return {\"ok\": true} even for ids that never existed, while GET/PUT handlers resolve the row first through the repository get() helpers and raise NotFound; only the item image and document deletes select the child row and can 404.",
      "evidence": [
        {
          "resource": "repo://server/src/repositories/container.rs#L30-L39",
          "version": "repo-lines-v1:sha256:46784d89488fc67e17e82ca3e1558e8f403584ab1ec8ea622f1e2df3927bb3a7:"
        },
        {
