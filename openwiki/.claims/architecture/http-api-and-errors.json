    {
      "id": "claim_bdee7c6182cc45cd971856f57db9fdba",
      "statement": "Image uploads are validated by extension against jpg/jpeg/png/webp/avif, then byte-capped against upload.max_file_size after the bytes are buffered, then decoded with image::load_from_memory; a 300px thumbnail is written as <uuid>_thumb.<ext> except for avif, which skips decoding so thumb_path equals file_path.",
      "evidence": [
        {
          "resource": "repo://server/src/services/image.rs#L7-L92",
          "version": "repo-lines-v1:sha256:bcbd475026cc3504074ff1b9ef621550795dddbb37df3111493b5a2d090d4980:"
        }
      ]
    },
    {
      "id": "claim_4a84c2b9fdde4a599b913b139c2e3cf1",
      "statement": "Document uploads accept only a .pdf extension, enforce upload.max_doc_size (default \"50MB\") after buffering the body, and store the file as {docs_dir}/pdf/{uuid}.pdf; these two rejection messages (\"只支持 PDF 文件\" and \"文件过大: ...\") are the only Chinese strings the API returns.",
      "evidence": [
        {
          "resource": "repo://server/src/config.rs#L34-L43",
