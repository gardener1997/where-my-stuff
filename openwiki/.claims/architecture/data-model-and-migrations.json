    },
    {
      "id": "claim_b1e74c051e6442518a3caee2edb7a417",
      "statement": "Category, container and tag mutations never resync items_fts, so renamed or deleted labels keep matching in search until the next process start rebuilds the index; only item create/update (sync_item) and item delete (explicit FTS row delete) touch the index during a running process.",
      "evidence": [
        {
          "resource": "repo://server/src/handlers/item.rs#L28-L58",
          "version": "repo-lines-v1:sha256:eb7cd210fd3bc241b4fd51124d8216c691d115fb35a7aa435a4a76c9ac141268:"
