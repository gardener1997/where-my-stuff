    },
    {
      "id": "claim_4e04b98d80514720a9810451bfd4f358",
      "statement": "Item updates replace nullable columns rather than merging them (description, location_note, purchased_at, bought_from, price, category_id, container_id are bound with as_deref()), whereas category and container updates use .or(existing.parent_id), so tree nodes can be re-parented but never detached to root through the API.",
      "evidence": [
        {
          "resource": "repo://server/src/repositories/category.rs#L42-L52",
          "version": "repo-lines-v1:sha256:176b3fce1ebac1c78c829d3fd19e8b566ad2f6a712b5ac897065bb65db65aeb5:"
