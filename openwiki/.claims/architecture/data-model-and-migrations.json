          "version": "repo-lines-v1:sha256:5cff64752ed1e8ff4b4031956fe8f0f805891e2c2a2719a97746f1c05d4985fd:"
        }
      ]
    },
    {
      "id": "claim_ab4edf7118ed498bb26c07431abf032c",
      "statement": "Tag creation is idempotent: tag::create returns an existing row when the name already exists, backed by the UNIQUE constraint on tags.name, so item_tags links never duplicate a label.",
      "evidence": [
        {
          "resource": "repo://server/migrations/0001_init.sql#L43-L53",
          "version": "repo-lines-v1:sha256:457e22aad68ed4db42efd28ecb7612eae06b7b29f3bac845b6d6684e366b1fa0:"
