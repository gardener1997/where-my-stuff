    },
    {
      "id": "claim_adb0196be11247308ea0de2f8367a1a3",
      "statement": "items_fts is a plain content-ful FTS5 table (item_id UNINDEXED plus the searchable text columns, tokenize='trigram') with no triggers and no external content, so it is a derived projection refreshed only by services/search_index.rs and never the authority for displayed data.",
      "evidence": [
        {
          "resource": "repo://server/migrations/0001_init.sql#L64-L74",
          "version": "repo-lines-v1:sha256:6013a74b349ea40e1c3419bb644f3cd14082537e34379aeeb6d59b2786934101:"
        },
        {
          "resource": "repo://server/src/services/search_index.rs#L1-L71",
          "version": "repo-lines-v1:sha256:36990240a61a55bb75e53fc505e0d1a76d4aa89459c6d58019392d1a15527c22:"
        }
      ]
    },
    {
      "id": "claim_c068062b263b43128d68d62fd352b579",
      "statement": "Migrations 0003 drops and recreates items_fts because an FTS5 virtual table's column set is fixed at creation time, and the emptied index is repopulated on the same startup by the sync_all call that main.rs makes right after db::init, best-effort with a warn-only failure path.",
      "evidence": [
        {
          "resource": "repo://server/migrations/0003_item_location_note.sql#L1-L15",
          "version": "repo-lines-v1:sha256:94384ad474f5cf29cd8fa02da98e7d1354a380b64d730d2027f0f8e9932321a2:"
        },
        {
