  "claims": [
    {
      "id": "claim_2d7e93512d7c40c7b3d4fc4a4ff74ae9",
      "statement": "The schema is embedded in the binary with sqlx::migrate!(\"./migrations\") and applied by db::init on every process start, after the pool is opened; a migration failure panics and aborts startup rather than serving with a partial schema.",
      "evidence": [
        {
          "resource": "repo://server/src/db.rs#L4-L25",
          "version": "repo-lines-v1:sha256:1368aab8825e378a10d9ad5fda684e8bed607d5c89ec8031523997adb14c2954:"
        },
        {
          "resource": "repo://server/src/main.rs#L33-L38",
          "version": "repo-lines-v1:sha256:cc4ae8d0fc47feee3923c16c5042d552f8817c72b5c39cb8a6666a5967088521:"
        }
      ]
    },
    {
      "id": "claim_aa2e14df58e547f7a7c0ae5d20fc447b",
      "statement": "Because sqlx validates the checksums of already-applied migrations, editing a migration file that has run against a database makes the next startup fail that validation and abort inside db::init's expect; schema changes must always land as a new numbered file in server/migrations.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L44-L48",
          "version": "repo-lines-v1:sha256:a2967b6d071ad1573a97a983838a32c71983c7ba8be71ccc89fe5fad3b00aa5d:"
        },
        {
          "resource": "repo://server/migrations/0003_item_location_note.sql#L1-L4",
          "version": "repo-lines-v1:sha256:94bceba43003e896070b9e299372d96a3d6df1ceef368ac4be7955e6cd3cd50c:"
        },
        {
          "resource": "repo://server/src/db.rs#L19-L22",
          "version": "repo-lines-v1:sha256:38f90d1d51b82636c8c8e7a414aaa1ff9ae1b8d0fb5175a11de575e16ec93f18:"
        }
      ]
    },
    {
      "id": "claim_a7257c4021c8444196b9f4600e2299eb",
      "statement": "A schema change requires a rebuild rather than a deploy-time command: migrate! reads server/migrations at compile time, and the justfile's build recipe lists server/migrations among the inputs that force a recompile.",
      "evidence": [
        {
          "resource": "repo://justfile#L42-L54",
          "version": "repo-lines-v1:sha256:99d6924754f4be702d6f74c2448db8424ba04ec2398b05e16794a5b220631e33:"
        },
        {
          "resource": "repo://server/src/db.rs#L19-L22",
          "version": "repo-lines-v1:sha256:38f90d1d51b82636c8c8e7a414aaa1ff9ae1b8d0fb5175a11de575e16ec93f18:"
        }
      ]
    },
    {
      "id": "claim_5539a12a8f4a45588bb9c07a36c97bc4",
      "statement": "The only reset mechanism shipped is the just reset-db recipe, which deletes the data/ directory wholesale (database plus uploaded files); no code path drops or recreates tables.",
      "evidence": [
        {
          "resource": "repo://justfile#L140-L150",
          "version": "repo-lines-v1:sha256:8492b2c0bb09691710eb0056283ac2dcc1a1b9105f2572b6b244d1428d1beeaa:"
        }
      ]
    },
    {
      "id": "claim_7fa720a5508b47559849c29a493e8822",
      "statement": "The base schema declares ON DELETE SET NULL for categories.parent_id, containers.parent_id, items.category_id and items.container_id, and ON DELETE CASCADE for item_images.item_id, item_tags (both columns) and item_documents.item_id; items_fts carries no foreign key at all.",
      "evidence": [
        {
          "resource": "repo://server/migrations/0001_init.sql#L1-L53",
          "version": "repo-lines-v1:sha256:72b4f7739302073edd5a81393afecf151112fb8efca1975c59d6e0e2a9e6e243:"
        },
        {
          "resource": "repo://server/migrations/0002_documents.sql#L1-L10",
          "version": "repo-lines-v1:sha256:0d6d52adfd6964561beb24525704fc68a1c0a448edb127ecbabe7ac32813b137:"
        }
      ]
    },
    {
      "id": "claim_f629b6807e194894bdd3abe005912327",
      "statement": "Category and container deletes do not depend on the declared actions: category::delete and container::delete first UPDATE items to NULL the category_id/container_id column and UPDATE children to NULL their parent_id, then DELETE the row, so children and items are detached deterministically.",
      "evidence": [
        {
          "resource": "repo://server/src/repositories/category.rs#L54-L68",
          "version": "repo-lines-v1:sha256:0842ad76d7d49dcb075d531dc7ebbd172d44b75c34e03aac5a257ebd8682219d:"
        },
        {
          "resource": "repo://server/src/repositories/container.rs#L91-L105",
          "version": "repo-lines-v1:sha256:523da6851c21e4563e56ce58541c55557339db7a152ac4d55819d04afcf74ded:"
        }
      ]
    },
    {
      "id": "claim_698a31d2dfcf4b7e94c570efc7074c7d",
      "statement": "item::delete performs no explicit deletion of child rows, so removal of item_images, item_tags and item_documents depends entirely on the declared CASCADE being enforced; no code in server/src issues PRAGMA foreign_keys, leaving enforcement to sqlx's connection defaults.",
      "evidence": [
        {
          "resource": "repo://server/src/db.rs#L9-L17",
          "version": "repo-lines-v1:sha256:492bfc15b5783ccc740ee1e9dd86a3bd6ffd47bdc1324ae6f43d02cf4ed65dbc:"
        },
        {
          "resource": "repo://server/src/repositories/item.rs#L222-L243",
          "version": "repo-lines-v1:sha256:75c300b0f3ad34bf1608aa9042db297c92d1032f4cb32348466915a24123d1ea:"
        }
      ]
    },
    {
      "id": "claim_48f90d5359c243ceaa9c6ec323268179",
      "statement": "Item deletion reads the item_images rows into memory before the DELETE (so file paths survive the cascade), then unlinks each image and its thumbnail via image::delete_image, while item_documents rows disappear but their PDF files under docs_dir/pdf are never removed.",
      "evidence": [
        {
          "resource": "repo://server/src/repositories/item.rs#L222-L243",
          "version": "repo-lines-v1:sha256:75c300b0f3ad34bf1608aa9042db297c92d1032f4cb32348466915a24123d1ea:"
        },
        {
          "resource": "repo://server/src/repositories/item.rs#L351-L375",
          "version": "repo-lines-v1:sha256:0cd6d6b0bef13b2b49073e184d00994020ea8e0fe2726c241329e382972f3ad0:"
        },
        {
          "resource": "repo://server/src/services/image.rs#L96-L100",
          "version": "repo-lines-v1:sha256:e4b272b39021af515be576ef93effb9c50cfbdb0a749fefd2e6006b8e7abcda3:"
        }
      ]
    },
    {
      "id": "claim_bccde62baa8245bfa35017123b37cc15",
      "statement": "Container images are never unlinked: container::delete removes only the row, and container::set_image overwrites image_path on re-upload, so the previous photo file stays on disk.",
      "evidence": [
        {
          "resource": "repo://server/src/handlers/container.rs#L103-L116",
          "version": "repo-lines-v1:sha256:d201c685932df759cb77c6195f34a0b169e3e21217421c2243d58f3466a2fbfb:"
