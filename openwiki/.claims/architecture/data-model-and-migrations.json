        }
      ]
    },
    {
      "id": "claim_7bbead646f16489583fda64b8678cdae",
      "statement": "Persistence conventions are UUID v4 TEXT primary keys generated in Rust, TEXT timestamps defaulted by datetime('now'), and an updated_at column only on items, maintained explicitly by item::update rather than by a trigger.",
      "evidence": [
        {
          "resource": "repo://server/migrations/0001_init.sql#L1-L47",
          "version": "repo-lines-v1:sha256:4345f54e2eb243e40672f64fe405cbe321479212530725101f83697cb9c75026:"
