        }
      ]
    },
    {
      "id": "claim_b62667695ef746f2a07e181ab2b9dba2",
      "statement": "The items_fts column order is part of the search contract: snippet() is called with indices 1, 2 and 3 for name, description and location_note, so adding or reordering FTS columns requires a matching change in repositories/search.rs.",
      "evidence": [
        {
          "resource": "repo://server/migrations/0003_item_location_note.sql#L5-L15",
          "version": "repo-lines-v1:sha256:34c886f47db5bb18189ab04d169f9fb70773a9026053df856be7500592982cc8:"
