    },
    {
      "id": "claim_2a066be7c2d946b4b252fecb6fed897e",
      "statement": "There is no compile-time SQL checking: queries are runtime query_as/query_scalar calls (some assembled with format! filter fragments) mapped through derive(FromRow) structs, with no query! macros, DATABASE_URL or .sqlx offline cache, and the database file is created if missing with a 5-connection pool.",
      "evidence": [
        {
          "resource": "repo://server/Cargo.toml#L7-L23",
          "version": "repo-lines-v1:sha256:d13d3601c77e38a4bb57aa1014225ad0021f58fd8eabc1b6c02534afa2f30284:"
        },
        {
          "resource": "repo://server/src/db.rs#L4-L25",
          "version": "repo-lines-v1:sha256:1368aab8825e378a10d9ad5fda684e8bed607d5c89ec8031523997adb14c2954:"
        },
        {
          "resource": "repo://server/src/repositories/item.rs#L9-L75",
          "version": "repo-lines-v1:sha256:a55a2a1ac8bffca126b9e6439c45f67aa044c81537b21cbb15aa1f959fc9a4be:"
        }
      ]
    },
    {
      "id": "claim_a986dd1347c0414fad5f908b7763aca7",
      "statement": "Multi-statement write paths are not wrapped in transactions: category/container delete, item::set_tags (delete-then-insert per tag), remove_document, and sync_all each issue independent statements, so a mid-sequence failure can leave partially applied data.",
      "evidence": [
        {
          "resource": "repo://server/src/repositories/category.rs#L54-L68",
          "version": "repo-lines-v1:sha256:0842ad76d7d49dcb075d531dc7ebbd172d44b75c34e03aac5a257ebd8682219d:"
