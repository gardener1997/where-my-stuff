    {
      "id": "claim_6416b9cc6ff84f798c437331e84fbad1",
      "statement": "Search-index coordination lives in the handlers rather than in a service or trigger: `POST /items` and `PUT /items/{id}` call `services::search_index::sync_item` after the write (a sync failure becomes a 500 for an already-committed row), and `DELETE /items/{id}` issues its own `DELETE FROM items_fts` raw SQL inline.",
      "evidence": [
        {
          "resource": "repo://server/src/handlers/item.rs#L28-L58",
          "version": "repo-lines-v1:sha256:eb7cd210fd3bc241b4fd51124d8216c691d115fb35a7aa435a4a76c9ac141268:"
