    },
    {
      "id": "claim_f3e0465a9c10423bac13ac0648bbe206",
      "statement": "No authentication or authorization layer exists: no middleware or extractor checks credentials, CORS is permissive, and `/images` plus `/docs` are unguarded static mounts, so the only access boundary is the network bind or an external reverse proxy.",
      "evidence": [
        {
          "resource": "repo://server/src/main.rs#L45-L53",
          "version": "repo-lines-v1:sha256:08c99ca09c589ba8d485eb7ebde9b440efef5c5dab908b73c3312ae671707f55:"
