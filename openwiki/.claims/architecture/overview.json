          "version": "repo-lines-v1:sha256:18b18c87a125b36e2ea174647597d10507a8984e8b55bb70c525aabda2b2e173:"
        }
      ]
    },
    {
      "id": "claim_54f4e8a957a7493b87676e3a86d3c019",
      "statement": "The real dependency pattern is thinner than the stated layering: handlers call repositories directly for nearly all CRUD (the category, tag, and stats handlers touch only repositories), and `services/` contains exactly two modules, `image` and `search_index`, so there is no service layer for transactions, policy, or item/container mutations.",
      "evidence": [
        {
          "resource": "repo://server/src/handlers/category.rs#L11-L39",
          "version": "repo-lines-v1:sha256:38103b1a5a6b821fda741d76e9a252baf9bfe2acd98e121b98f26c395f5137a8:"
