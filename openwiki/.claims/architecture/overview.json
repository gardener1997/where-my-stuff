    {
      "id": "claim_e941d73fb326423e965edca8ac2755d6",
      "statement": "All handler failures funnel through the single `AppError` enum (`NotFound`/`BadRequest`/`Internal`) whose `IntoResponse` emits `{ \"error\": message }`; `sqlx::Error::RowNotFound` maps to 404, other SQL and any `std::io::Error` map to `Internal`, which is logged via `tracing::error!` and returned to clients as the fixed string `internal server error`.",
      "evidence": [
        {
          "resource": "repo://server/src/error.rs#L8-L63",
          "version": "repo-lines-v1:sha256:2bd3a75a4e8160674a55c022b70aca29dce89e348977729b027c17dc67ed3329:"
        }
