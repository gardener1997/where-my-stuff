    {
      "id": "claim_7b384364618c4c198a66f0c28c1cae2b",
      "statement": "There is a real layer inversion: `repositories::item::delete` calls `services::image::delete_image` to unlink image and thumbnail files after deleting the row, so a repository depends upward on the service layer for file cleanup.",
      "evidence": [
        {
          "resource": "repo://server/src/repositories/item.rs#L222-L243",
          "version": "repo-lines-v1:sha256:75c300b0f3ad34bf1608aa9042db297c92d1032f4cb32348466915a24123d1ea:"
