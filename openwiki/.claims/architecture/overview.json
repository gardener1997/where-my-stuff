    {
      "id": "claim_726ca0ab75284f0da2ea1b8b7e57f0c1",
      "statement": "The documented layering boundary is `routes.rs` → `handlers/` (HTTP only) → `services/` (images, FTS sync) → `repositories/` (SQL) → `models/` (DTOs), with `routes.rs` holding no logic beyond a flat route table plus `.with_state(pool)`.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L14-L14",
          "version": "repo-lines-v1:sha256:680bbb7806cc8aa59b4ffa9c6f80015facf02bbbea5e31368d2dc107f667a15b:"
        },
        {
