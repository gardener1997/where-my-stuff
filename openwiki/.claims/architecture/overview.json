    {
      "id": "claim_e925f3527e674b0c91f90b0cea1b37e6",
      "statement": "Image uploads flow through `services::image::save_image` (extension whitelist, size cap, UUID filename, 300 px thumbnail, AVIF skipping thumbnailing, DB path stored relative to `image_dir`), whereas PDF uploads are handled inline in the handler with pdf-only and `max_doc_size` checks and a direct `std::fs::write` into `docs_dir/pdf`.",
      "evidence": [
