    {
      "id": "claim_dac8c74cef944234a3df93bf3e57c29f",
      "statement": "Thumbnails are generated by image::thumbnail(300, 300) into {uuid}_thumb.{ext} with jpeg normalized to jpg and the encoder chosen from that extension; AVIF short-circuits before decoding and returns file_path as its own thumb_path, so an AVIF image has no separate thumbnail file on disk.",
      "evidence": [
        {
          "resource": "repo://server/src/services/image.rs#L57-L91",
