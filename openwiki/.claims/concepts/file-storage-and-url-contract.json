    {
      "id": "claim_2c6604f820ca4ff8b5734beeb7b020c4",
      "statement": "save_image validates in the order size-then-extension: it rejects a part whose already-buffered bytes exceed max_size, then requires a lowercase extension among jpg, jpeg, png, webp, avif, and only then writes the original under an id-based filename ({uuid}.{ext}) — the client filename contributes only its extension, never the stored path.",
      "evidence": [
        {
          "resource": "repo://server/src/handlers/item.rs#L72-L89",
          "version": "repo-lines-v1:sha256:b043434380d4625706101d66084bdbf481897d342beb72cbf8adb8bfad52436b:"
